---
import { Lock, Mail, Search, Play } from "@lucide/astro";

/* ─── What this html-gif shows ──────────────────────────────────────────────
 *
 * A macOS-Chrome window with a Gmail inbox docked next to the real Mail Warmer
 * sidepanel (Gmail blue). A 12-second synchronized loop mirrors real life: as
 * the sidepanel subscribes to each newsletter, a "Confirm your subscription"
 * email lands at the top of the inbox.
 *
 *   t=0.0s  Idle. Inbox holds one old "welcome" mail. Badge 0.
 *   t=1.0s  "Run" (blue compose btn) presses → ripple.
 *   t=2.9s  Row 1 → success. The Daily Brief confirmation lands. Badge 1.
 *   t=4.6s  Row 2 → success. Morning Roast confirmation lands. Badge 2.
 *   t=6.2s  Row 3 → success. Tech in Five confirmation lands. Badge 3.
 *   t=7.0s  Hold: three unread confirmations stacked, newest on top.
 *   t=10.8s Reset: confirmations fade out, badge → 0.
 *   t=12.0s Loop.
 *
 * Pure CSS keyframes, zero JS. Respects prefers-reduced-motion (frozen at the
 * resolved state). All classes prefixed `.ap-` so they can't leak.
 */
---

<section
  id="preview"
  class="relative overflow-x-clip px-4 py-16 md:px-6 md:py-24"
>
  <div
    class="blob"
    aria-hidden="true"
    style="top: 20%; left: -20%; width: 380px; height: 380px; background: #e8f0fe;"
  >
  </div>

  <div class="reveal-group mx-auto max-w-3xl text-center">
    <span
      class="reveal text-xs font-medium tracking-widest text-stone-500 uppercase"
    >
      How it works
    </span>
    <h2 class="reveal mt-3 text-3xl font-medium tracking-tight md:text-5xl">
      Watch the confirmations
      <span
        class="accent-word text-[1.1em] leading-none"
      >land</span>.
    </h2>
    <p class="reveal text-muted mx-auto mt-5 max-w-xl text-base md:text-lg">
      Pick your emails and newsletters, hit Run, and each subscription drops a
      real confirmation into the inbox — live, one at a time, just like a person
      signing up by hand.
    </p>
  </div>

  <!-- Live badge -->
  <div class="reveal mx-auto mt-10 flex items-center justify-center gap-2">
    <span class="relative flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
        style="background-color: #1a73e8;"></span>
      <span
        class="relative inline-flex h-2 w-2 rounded-full"
        style="background-color: #1a73e8;"></span>
    </span>
    <span class="text-xs tracking-widest text-stone-500 uppercase">
      Live demo · looping
    </span>
  </div>

  <!-- ─── The mockup ─────────────────────────────────────────────────────── -->
  <div class="reveal mx-auto mt-10 w-full max-w-5xl" style="perspective: 1400px;">
    <div class="ap-shell">
      <div class="ap-window">
        <!-- Chrome titlebar -->
        <div class="ap-titlebar">
          <div class="ap-traffic" aria-hidden="true">
            <span class="ap-tl ap-tl-red"></span>
            <span class="ap-tl ap-tl-yellow"></span>
            <span class="ap-tl ap-tl-green"></span>
          </div>
          <div class="ap-tabstrip">
            <div class="ap-tab ap-tab-active">
              <span class="ap-tab-fav" aria-hidden="true"></span>
              <span class="ap-tab-title">Inbox — warm.inbox@gmail.com</span>
            </div>
            <span class="ap-tab-plus" aria-hidden="true">+</span>
          </div>
        </div>

        <!-- Chrome URL bar -->
        <div class="ap-urlbar">
          <div class="ap-urlbtn" aria-hidden="true">‹</div>
          <div class="ap-urlbtn" aria-hidden="true">›</div>
          <div class="ap-urlbtn" aria-hidden="true">↻</div>
          <div class="ap-urlpill">
            <Lock size={11} strokeWidth={2.25} class="text-stone-500" />
            <span>mail.google.com/mail/u/0/#inbox</span>
          </div>
          <!-- Extension toolbar icon + counting badge (unread confirmations) -->
          <div class="ap-urlright">
            <span class="ap-ext" aria-hidden="true">
              <Mail size={12} color="#5a4a4e" strokeWidth={2.25} />
              <span class="ap-badge">
                <span class="ap-badge-n ap-badge-0">0</span>
                <span class="ap-badge-n ap-badge-1">1</span>
                <span class="ap-badge-n ap-badge-2">2</span>
                <span class="ap-badge-n ap-badge-3">3</span>
              </span>
            </span>
          </div>
        </div>

        <!-- Body: Gmail inbox + sidepanel split -->
        <div class="ap-body">
          <!-- ── Gmail inbox ── -->
          <div class="ap-inbox">
            <div class="ap-gm-top">
              <span class="ap-gm-logo" aria-hidden="true">
                <Mail size={14} color="#ea4335" strokeWidth={2.25} />
              </span>
              <span class="ap-gm-title">Inbox</span>
              <div class="ap-gm-search">
                <Search size={11} class="text-stone-500" strokeWidth={2} />
                <span>Search mail</span>
              </div>
              <span class="ap-gm-avatar" aria-hidden="true">W</span>
            </div>

            <div class="ap-gm-subbar">
              <span class="ap-gm-tab ap-gm-tab-active">Primary</span>
              <span class="ap-gm-tab">Promotions</span>
              <span class="ap-gm-tab">Social</span>
            </div>

            <!-- Newest on top: confirmations land above the old welcome mail. -->
            <ul class="ap-mails">
              <li class="ap-mail ap-mail-3">
                <span class="ap-mail-dot" aria-hidden="true"></span>
                <span class="ap-mail-fav" style="background:#00a3a3"></span>
                <div class="ap-mail-text">
                  <div class="ap-mail-line1">
                    <span class="ap-mail-from">Tech in Five</span>
                    <span class="ap-mail-time">now</span>
                  </div>
                  <div class="ap-mail-subj">Confirm your subscription</div>
                  <div class="ap-mail-snip">
                    One tap to start getting Tech in Five each week.
                  </div>
                </div>
              </li>
              <li class="ap-mail ap-mail-2">
                <span class="ap-mail-dot" aria-hidden="true"></span>
                <span class="ap-mail-fav" style="background:#6d4aff"></span>
                <div class="ap-mail-text">
                  <div class="ap-mail-line1">
                    <span class="ap-mail-from">Morning Roast</span>
                    <span class="ap-mail-time">now</span>
                  </div>
                  <div class="ap-mail-subj">Confirm your subscription</div>
                  <div class="ap-mail-snip">
                    Please confirm your email to get the daily Roast.
                  </div>
                </div>
              </li>
              <li class="ap-mail ap-mail-1">
                <span class="ap-mail-dot" aria-hidden="true"></span>
                <span class="ap-mail-fav" style="background:#ff6719"></span>
                <div class="ap-mail-text">
                  <div class="ap-mail-line1">
                    <span class="ap-mail-from">The Daily Brief</span>
                    <span class="ap-mail-time">now</span>
                  </div>
                  <div class="ap-mail-subj">Confirm your subscription</div>
                  <div class="ap-mail-snip">
                    Tap to confirm and get the brief every morning.
                  </div>
                </div>
              </li>

              <!-- Baseline: an old, read welcome mail — always present. -->
              <li class="ap-mail ap-mail-base">
                <span class="ap-mail-fav" style="background:#1a73e8"></span>
                <div class="ap-mail-text">
                  <div class="ap-mail-line1">
                    <span class="ap-mail-from ap-read">Gmail Team</span>
                    <span class="ap-mail-time ap-read">9:01</span>
                  </div>
                  <div class="ap-mail-subj ap-read">Welcome to your new inbox</div>
                  <div class="ap-mail-snip">
                    Tips for getting the most out of Gmail.
                  </div>
                </div>
              </li>
            </ul>
          </div>

          <!-- ── Mail Warmer sidepanel (Gmail blue) ── -->
          <aside class="ap-sp">
            <div class="ap-sp-top">
              <span class="ap-sp-logo" aria-hidden="true"></span>
              <span class="ap-sp-brand">Mail Warmer</span>
              <span class="ap-sp-ver">0.6.0</span>
            </div>

            <button class="ap-compose" type="button">
              <span class="ap-compose-idle">
                <Play size={15} strokeWidth={2.5} />
                Run
              </span>
              <span class="ap-compose-running">Running…</span>
            </button>

            <div class="ap-sp-nav">
              <span class="ap-sp-navi ap-sp-navi-active">Run</span>
              <span class="ap-sp-navi">Emails</span>
              <span class="ap-sp-navi">Lists</span>
              <span class="ap-sp-navi">Log</span>
            </div>

            <div class="ap-sp-label">Newsletters · warm.inbox@gmail.com</div>
            <ul class="ap-list">
              <li class="ap-li">
                <span class="ap-li-fav ap-fav-a"></span>
                <span class="ap-li-name">The Daily Brief</span>
                <span class="ap-pill ap-pill-1">
                  <span class="ap-pill-pending">pending</span>
                  <span class="ap-pill-running">running</span>
                  <span class="ap-pill-success">✓ done</span>
                </span>
              </li>
              <li class="ap-li">
                <span class="ap-li-fav ap-fav-b"></span>
                <span class="ap-li-name">Morning Roast</span>
                <span class="ap-pill ap-pill-2">
                  <span class="ap-pill-pending">pending</span>
                  <span class="ap-pill-running">running</span>
                  <span class="ap-pill-success">✓ done</span>
                </span>
              </li>
              <li class="ap-li">
                <span class="ap-li-fav ap-fav-c"></span>
                <span class="ap-li-name">Tech in Five</span>
                <span class="ap-pill ap-pill-3">
                  <span class="ap-pill-pending">pending</span>
                  <span class="ap-pill-running">running</span>
                  <span class="ap-pill-success">✓ done</span>
                </span>
              </li>
            </ul>

            <div class="ap-sp-foot">
              <span class="ap-progress"><span class="ap-progress-bar"></span></span>
              <span class="ap-progress-text">3 inboxes kept warm</span>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── Mockup styles ───────────────────────────────────────────────────── -->
<style is:global>
  .ap-shell {
    position: relative;
    width: 100%;
    transform: rotateX(1deg);
    filter: drop-shadow(0 30px 60px rgba(60, 64, 67, 0.14))
      drop-shadow(0 12px 24px rgba(60, 64, 67, 0.1));
  }
  .ap-window {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Titlebar ── */
  .ap-titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 0;
    background: linear-gradient(180deg, #ededeb 0%, #e4e4e1 100%);
    height: 36px;
  }
  .ap-traffic {
    display: flex;
    gap: 7px;
    flex-shrink: 0;
  }
  .ap-tl {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.15);
  }
  .ap-tl-red {
    background: #ff5f57;
  }
  .ap-tl-yellow {
    background: #febc2e;
  }
  .ap-tl-green {
    background: #28c840;
  }
  .ap-tabstrip {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    margin-left: 12px;
    flex: 1;
    height: 100%;
  }
  .ap-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 6px;
    max-width: 260px;
    font-size: 11px;
    color: #52525b;
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    position: relative;
    top: 1px;
  }
  .ap-tab-active {
    background: #fafaf9;
    color: #1c1c1c;
    font-weight: 500;
  }
  .ap-tab-fav {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: #ea4335; /* gmail red */
    flex-shrink: 0;
  }
  .ap-tab-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ap-tab-plus {
    color: #9ca3af;
    font-size: 14px;
    padding: 3px 8px;
  }

  /* ── URL bar ── */
  .ap-urlbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #fafaf9;
    border-bottom: 1px solid #e7e5e4;
  }
  .ap-urlbtn {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #78716c;
    font-size: 14px;
  }
  .ap-urlpill {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: #f3f3f2;
    border-radius: 9999px;
    font-size: 11px;
    color: #374151;
    min-width: 0;
  }
  .ap-urlpill span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ap-urlright {
    display: flex;
    align-items: center;
    padding-left: 4px;
  }
  .ap-ext {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: #fff1e2;
  }
  /* Counting badge — 4 stacked digits cross-fade in their window. */
  .ap-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 15px;
    height: 15px;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    font-size: 9px;
    font-weight: 700;
    color: #fff;
    background: #b06000; /* running orange */
    box-shadow: 0 0 0 1.5px #fafaf9;
    animation: ap-badge-bg 12s ease-in-out infinite;
  }
  .ap-badge-n {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .ap-badge-0 {
    animation: ap-b0 12s ease-in-out infinite;
  }
  .ap-badge-1 {
    animation: ap-b1 12s ease-in-out infinite;
  }
  .ap-badge-2 {
    animation: ap-b2 12s ease-in-out infinite;
  }
  .ap-badge-3 {
    animation: ap-b3 12s ease-in-out infinite;
  }
  @keyframes ap-badge-bg {
    0%, 7% { background: #b06000; }
    8%, 49% { background: #b06000; }
    /* turns green once all three are done */
    52%, 87% { background: #137333; }
    92%, 100% { background: #b06000; }
  }
  @keyframes ap-b0 {
    0%, 7% { opacity: 1; }
    9%, 100% { opacity: 0; }
    /* reappears on reset */
    92%, 100% { opacity: 1; }
  }
  @keyframes ap-b1 {
    0%, 20% { opacity: 0; }
    23%, 34% { opacity: 1; }
    37%, 100% { opacity: 0; }
  }
  @keyframes ap-b2 {
    0%, 34% { opacity: 0; }
    37%, 48% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  @keyframes ap-b3 {
    0%, 48% { opacity: 0; }
    51%, 88% { opacity: 1; }
    92%, 100% { opacity: 0; }
  }

  /* ── Body split ── */
  .ap-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 232px;
    background: #fff;
    min-height: 500px;
  }
  @media (max-width: 767px) {
    .ap-body {
      grid-template-columns: 1fr;
    }
  }

  /* ── Gmail inbox ── */
  .ap-inbox {
    display: flex;
    flex-direction: column;
    border-right: 1px solid #e7e5e4;
    background: #fff;
    min-width: 0;
  }
  @media (max-width: 767px) {
    .ap-inbox {
      border-right: none;
      border-bottom: 1px solid #e7e5e4;
    }
  }
  .ap-gm-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid #f1f1ef;
  }
  .ap-gm-logo {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: #fce8e6;
    flex-shrink: 0;
  }
  .ap-gm-title {
    font-weight: 600;
    font-size: 13px;
    color: #202124;
  }
  .ap-gm-search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    background: #f1f3f4;
    font-size: 11px;
    color: #5f6368;
    min-width: 0;
  }
  .ap-gm-search span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ap-gm-avatar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: #1a73e8;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .ap-gm-subbar {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 0 16px;
    border-bottom: 1px solid #f1f1ef;
  }
  .ap-gm-tab {
    padding: 9px 14px;
    font-size: 11px;
    font-weight: 600;
    color: #5f6368;
    border-bottom: 2px solid transparent;
  }
  .ap-gm-tab-active {
    color: #1a73e8;
    border-bottom-color: #1a73e8;
  }

  .ap-mails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .ap-mail {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 11px 16px;
    border-bottom: 1px solid #f1f1ef;
    background: #fff;
    overflow: hidden;
    min-width: 0;
  }
  /* Unread confirmation rows: bold, with a blue dot; collapsed until they
     "arrive" in sync with the matching sidepanel row turning ✓ done. */
  .ap-mail-dot {
    margin-top: 5px;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #1a73e8;
    flex-shrink: 0;
  }
  .ap-mail-base .ap-mail-fav {
    margin-left: 17px; /* align with rows that have a dot */
  }
  .ap-mail-fav {
    margin-top: 1px;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .ap-mail-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ap-mail-line1 {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ap-mail-from {
    font-size: 12px;
    font-weight: 700;
    color: #202124;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ap-mail-time {
    font-size: 10px;
    font-weight: 600;
    color: #1a73e8;
    flex-shrink: 0;
  }
  .ap-mail-subj {
    font-size: 12px;
    font-weight: 700;
    color: #202124;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ap-mail-snip {
    font-size: 11px;
    color: #5f6368;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  /* Read (old) mail: lighter weight, muted time. */
  .ap-mail-from.ap-read,
  .ap-mail-subj.ap-read {
    font-weight: 500;
    color: #5f6368;
  }
  .ap-mail-time.ap-read {
    color: #80868b;
    font-weight: 500;
  }

  /* Arrival animations — each confirmation expands + flashes blue when the
     matching sidepanel row hits ✓ done, then holds, then resets. */
  .ap-mail-1,
  .ap-mail-2,
  .ap-mail-3 {
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
  }
  .ap-mail-1 { animation: ap-mailin-1 12s ease-in-out infinite; }
  .ap-mail-2 { animation: ap-mailin-2 12s ease-in-out infinite; }
  .ap-mail-3 { animation: ap-mailin-3 12s ease-in-out infinite; }

  @keyframes ap-mailin-1 {
    0%, 22% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
    26% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #e8f0fe; }
    32%, 90% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #fff; }
    94%, 100% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
  }
  @keyframes ap-mailin-2 {
    0%, 36% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
    40% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #e8f0fe; }
    46%, 90% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #fff; }
    94%, 100% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
  }
  @keyframes ap-mailin-3 {
    0%, 50% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
    54% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #e8f0fe; }
    60%, 90% { max-height: 80px; padding-top: 11px; padding-bottom: 11px; opacity: 1; background: #fff; }
    94%, 100% { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; background: #e8f0fe; }
  }

  /* ── Sidepanel ── */
  .ap-sp {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    background: #f6f8fc;
    border-left: 1px solid #e7e5e4;
  }
  @media (max-width: 767px) {
    .ap-sp {
      border-left: none;
    }
  }
  .ap-sp-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 2px 8px;
  }
  .ap-sp-logo {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: linear-gradient(160deg, #ffe0c2, #ffb9a8);
    box-shadow: inset 0 0 0 1.5px #5a4a4e;

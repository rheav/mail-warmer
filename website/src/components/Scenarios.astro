---
/* The cold-inbox story — a quiet timeline of an account going dormant.
   Accent dots ramp cool→warm to foreshadow the fix. */
import { getLang } from "../i18n";

const accents = ["#80868b", "#a3b3c9", "#c9b4a8", "#ffcdb8", "#ffb9a8", "#1a73e8"];
const c = {
  en: {
    steps: [
      ["Day 0", "You spin up a fresh inbox for a new project."],
      ["Day 9", "It sits empty. No mail in, no mail out."],
      ["Day 21", "Providers start flagging it as dormant."],
      ["Day 34", "You sign up somewhere with it — and get blocked."],
      ["Day 48", "The account gets limited, then quietly suspended."],
      ["Tomorrow", "It could just stay active on its own."],
    ],
    kicker: "Why inboxes go cold",
    h2a: "A quiet inbox is a",
    accent: "dying",
    h2b: " inbox.",
    body: "Providers trust accounts that look used. A silent inbox gets flagged as dormant and risks being limited or locked — right when you need it to sign up for social, affiliate, or a new account.",
    coda: "— let's keep it warm.",
  },
  "pt-br": {
    steps: [
      ["Dia 0", "Você cria uma caixa nova para um projeto."],
      ["Dia 9", "Ela fica vazia. Nada entra, nada sai."],
      ["Dia 21", "Os provedores começam a marcá-la como inativa."],
      ["Dia 34", "Você usa ela num cadastro — e é bloqueado."],
      ["Dia 48", "A conta é limitada e depois suspensa sem aviso."],
      ["Amanhã", "Ela poderia continuar ativa sozinha."],
    ],
    kicker: "Por que caixas esfriam",
    h2a: "Caixa parada é caixa",
    accent: "morrendo",
    h2b: ".",
    body: "Provedores confiam em contas que parecem usadas. Uma caixa silenciosa é marcada como inativa e corre o risco de ser limitada ou travada — justo quando você precisa dela para um cadastro em rede social, afiliados ou um serviço novo.",
    coda: "— vamos mantê-la aquecida.",
  },
}[getLang(Astro.url)];
const scenarios = c.steps.map(([time, text], i) => ({ time, text, accent: accents[i] }));
---

<section id="scenarios" class="relative overflow-x-clip px-6 py-14 md:py-20">
  <div
    class="mx-auto grid max-w-6xl items-start gap-12 md:grid-cols-[1.2fr_1fr] md:gap-20"
  >
    <!-- Cards (left) -->
    <ol
      class="reveal-group order-2 grid grid-cols-1 gap-4 sm:grid-cols-2 md:order-1 md:gap-5"
    >
      {
        scenarios.map((s, i) => (
          <li
            class="reveal group relative flex min-h-[160px] flex-col justify-between rounded-[1.75rem] border border-stone-100 bg-white p-5 shadow-soft transition-transform duration-500 hover:-translate-y-0.5"
            style={`--stagger: ${i * 60}ms;`}
          >
            <div class="flex items-center gap-2">
              <span
                class="block h-2 w-2 rounded-full"
                style={`background-color: ${s.accent};`}
              />
              <span class="text-sm font-medium text-stone-500">{s.time}</span>
            </div>
            <p
              class="mt-4 text-base leading-snug text-stone-800 transition-colors duration-500 group-hover:text-[color:var(--accent)] md:text-lg"
              style={`--accent: ${s.accent};`}
            >
              {s.text}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- Heading (right, sticky on desktop) -->
    <div
      class="reveal-group order-1 md:order-2 md:sticky md:top-32 md:self-start md:text-left"
    >
      <span
        class="reveal text-xs font-medium tracking-widest text-stone-500 uppercase"
      >
        {c.kicker}
      </span>
      <h2 class="reveal mt-3 text-3xl font-medium tracking-tight md:text-5xl">
        {c.h2a}
        <span
          class="accent-word text-[1.1em] leading-none"
        >{c.accent}</span>{c.h2b}
      </h2>
      <p class="reveal text-muted mt-5 max-w-md text-base md:text-lg">
        {c.body}
      </p>

      <p
        class="reveal mt-10 hidden text-2xl leading-none font-medium text-stone-500 italic md:block"
      >
        {c.coda}
      </p>
    </div>
  </div>
</section>

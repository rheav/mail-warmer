---
import LogoMark from "./LogoMark.astro";
import { repoUrl } from "../data/site";
import { getLang, localize } from "../i18n";
const year = new Date().getFullYear();
const lang = getLang(Astro.url);
const c = {
  en: { install: "Install", docs: "Docs", faq: "FAQ", changelog: "Changelog", privacy: "Privacy", terms: "Terms", source: "Source", tagline: "Made to keep things warm." },
  "pt-br": { install: "Instalar", docs: "Docs", faq: "Dúvidas", changelog: "Novidades", privacy: "Privacidade", terms: "Termos", source: "Código", tagline: "Feito para manter tudo aquecido." },
}[lang];
---

<footer class="relative px-6 pt-16 pb-10 text-sm text-stone-500">
  <div
    class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-6 border-t border-stone-200/80 pt-10 md:flex-row md:items-center"
  >
    <div class="flex items-center gap-3">
      <LogoMark size={26} />
      <span class="text-ink font-medium">mailWarmer</span>
      <span class="text-stone-500">·</span>
      <span>© {year}</span>
    </div>

    <nav
      class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs tracking-widest text-stone-500 uppercase"
    >
      <a href={localize(lang, "/#install")} class="footer-link">{c.install}</a>
      <a href={localize(lang, "/docs")} class="footer-link">{c.docs}</a>
      <a href={localize(lang, "/#faq")} class="footer-link">{c.faq}</a>
      <a href={localize(lang, "/changelog")} class="footer-link">{c.changelog}</a>
      <a href={localize(lang, "/privacy")} class="footer-link">{c.privacy}</a>
      <a href={localize(lang, "/terms")} class="footer-link">{c.terms}</a>
      <a
        href={repoUrl}
        class="footer-link"
        rel="noopener">{c.source}</a
      >
    </nav>
  </div>

  <p class="mx-auto mt-8 max-w-5xl text-xs text-stone-500">
    {c.tagline}
  </p>
</footer>

<style>
  .footer-link {
    position: relative;
    padding-bottom: 3px;
    background-image: linear-gradient(to right, var(--color-blue), #4285f4);
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    background-position: 0 100%;
    transition:
      color 300ms ease,
      background-size 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-ink);
    background-size: 100% 1.5px;
    outline: none;
  }
</style>

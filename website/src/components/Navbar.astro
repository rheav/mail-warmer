---
/**
 * Navbar — floating pill, always visible.
 *
 * Nav links get a left→right blue underline wipe + a gentle color warming on
 * hover. The single CTA is the ChromeButton (small). Logo = the envelope mark.
 */
import ChromeButton from "./ChromeButton.astro";
import LogoMark from "./LogoMark.astro";
import { cleanPath, getLang, langs, localize } from "../i18n";

const lang = getLang(Astro.url);
const here = cleanPath(Astro.url.pathname);
const c = {
  en: {
    nav: "Main", home: "mailWarmer home", problem: "The problem", how: "How it works",
    features: "Features", docs: "Docs", faq: "Questions", cta: "Add to browser", switch: "Language",
  },
  "pt-br": {
    nav: "Principal", home: "Início do mailWarmer", problem: "O problema", how: "Como funciona",
    features: "Recursos", docs: "Docs", faq: "Dúvidas", cta: "Adicionar ao navegador", switch: "Idioma",
  },
}[lang];
const short = { en: "EN", "pt-br": "PT" } as const;
---

<nav
  class="fixed top-4 right-4 left-4 z-40 mx-auto flex max-w-5xl items-center justify-between rounded-full border border-stone-200/70 px-4 py-2 shadow-soft backdrop-blur-xl md:px-6 md:py-2.5"
  style="background-color: rgba(255, 255, 255, 0.72);"
  aria-label={c.nav}
>
  <a href={localize(lang, "/")} class="group flex items-center gap-2" aria-label={c.home}>
    <span class="nav-logo-chip relative flex items-center justify-center">
      <LogoMark size={26} />
    </span>
    <span class="text-ink text-base font-medium tracking-tight">
      mailWarmer
    </span>
  </a>

  <div
    class="hidden items-center gap-6 text-sm font-medium text-stone-500 md:flex"
  >
    <a href={localize(lang, "/#scenarios")} class="nav-link">{c.problem}</a>
    <a href={localize(lang, "/#preview")} class="nav-link">{c.how}</a>
    <a href={localize(lang, "/#features")} class="nav-link">{c.features}</a>
    <a href={localize(lang, "/docs")} class="nav-link">{c.docs}</a>
    <a href={localize(lang, "/#faq")} class="nav-link">{c.faq}</a>
  </div>

  <div class="flex items-center gap-3">
    <div class="lang-switch" role="group" aria-label={c.switch}>
      {
        langs.map((l) => (
          <a
            href={localize(l, here)}
            hreflang={l === "pt-br" ? "pt-BR" : "en"}
            aria-current={l === lang ? "true" : undefined}
          >
            {short[l]}
          </a>
        ))
      }
    </div>
    <ChromeButton size="small">{c.cta}</ChromeButton>
  </div>
</nav>

<style>
  .nav-link {
    position: relative;
    padding: 2px 0;
    color: var(--color-muted);
    background-image: linear-gradient(
      to right,
      var(--color-blue),
      #4285f4
    );
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    background-position: 0 100%;
    transition:
      color 450ms ease,
      background-size 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-ink);
    background-size: 100% 1.5px;
    outline: none;
  }

  .lang-switch {
    display: flex;
    padding: 2px;
    border-radius: 9999px;
    background-color: var(--color-stone-100);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .lang-switch a {
    padding: 4px 9px;
    border-radius: 9999px;
    color: var(--color-muted);
    transition: color 200ms ease, background-color 200ms ease;
  }
  .lang-switch a:hover {
    color: var(--color-ink);
  }
  .lang-switch a[aria-current="true"] {
    background-color: #fff;
    color: var(--color-blue);
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.15);
  }

  .nav-logo-chip {
    transition: filter 400ms ease;
  }
  .group:hover .nav-logo-chip {
    filter: brightness(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link:hover,
    .lang-switch {
    display: flex;
    padding: 2px;
    border-radius: 9999px;
    background-color: var(--color-stone-100);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .lang-switch a {
    padding: 4px 9px;
    border-radius: 9999px;
    color: var(--color-muted);
    transition: color 200ms ease, background-color 200ms ease;
  }
  .lang-switch a:hover {
    color: var(--color-ink);
  }
  .lang-switch a[aria-current="true"] {
    background-color: #fff;
    color: var(--color-blue);
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.15);
  }

  .nav-logo-chip {
      transition: color 200ms ease !important;
    }
  }
</style>

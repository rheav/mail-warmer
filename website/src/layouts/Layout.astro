---
import "../styles/global.css";
import FloatingSteam from "../components/FloatingSteam.astro";
import { absoluteUrl, getLang, langs, langTag } from "../i18n";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.url);
const defaults = {
  en: {
    title: "mailWarmer — keep every inbox warm",
    description:
      "A Chrome extension that auto-subscribes your email addresses to curated newsletters, so fresh inboxes stay active, trusted accounts — usable for social, affiliate, and new-service signups without getting flagged. Free, open source, no account or setup.",
  },
  "pt-br": {
    title: "mailWarmer — mantenha cada caixa de entrada aquecida",
    description:
      "Extensão do Chrome que inscreve seus e-mails em newsletters selecionadas, para que caixas novas continuem ativas e confiáveis — prontas para cadastros em redes sociais, afiliados e novos serviços sem serem bloqueadas. Grátis, código aberto, sem conta.",
  },
}[lang];
const { title = defaults.title, description = defaults.description } = Astro.props;
const canonical = absoluteUrl(lang, Astro.url.pathname);
---

<!doctype html>
<html lang={langTag[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8fc" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={langTag[l]} href={absoluteUrl(l, Astro.url.pathname)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteUrl("en", Astro.url.pathname)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={langTag[lang].replace("-", "_")} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- No-JS fallback: scroll-reveal elements start hidden, so force them
         visible when JavaScript is unavailable. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-canvas text-ink relative overflow-x-hidden">
    <!-- Grain overlay: fixed, z-50, mix-blend-mode overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Ambient rising warmth, z-5, behind content -->
    <FloatingSteam />

    <slot />

    <script>
      // Intersection-observer-backed reveal. Runs once per element.
      function initReveal() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document
            .querySelectorAll(".reveal")
            .forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      }
      initReveal();
    </script>
  </body>
</html>

{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.7.0",
  "version_name": "0.7.0 — Português and zero server connections",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "webNavigation",
    "cookies"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "public/logo.png",
    "32": "public/logo.png",
    "48": "public/logo.png",
    "128": "public/logo.png"
  },
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "public/logo.png",
      "32": "public/logo.png",
      "48": "public/logo.png",
      "128": "public/logo.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  }
}
